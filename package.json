{
  "name": "shaoye-reimburse",
  "productName": "少爷今天报销了吗",
  "version": "1.1.1",
  "description": "本地图片识别、开票提醒和报销管理桌面应用",
  "author": "Shaoye Reimburse",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "test:ocr": "node scripts/test-ocr.mjs",
    "test:invoice-reader": "node scripts/test-invoice-reader.mjs",
    "test:invoices": "node scripts/smoke-invoices.mjs",
    "package": "npm run build && npm run prepare:ocr && electron-builder --win nsis --x64",
    "package:dir": "npm run build && npm run prepare:ocr && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@gutenye/ocr-models": "1.4.2",
    "@gutenye/ocr-node": "1.4.9",
    "@napi-rs/canvas": "1.0.13",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "1.30.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "tesseract.js": "^7.0.0",
    "yazl": "3.3.1"
  },
  "overrides": {
    "@gutenye/ocr-node": {
      "sharp": "$sharp"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "yauzl": "3.4.0"
  },
  "build": {
    "appId": "com.shaoye.reimburse",
    "productName": "少爷今天报销了吗",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "assets/icon.png",
      "assets/icon.ico",
      "THIRD_PARTY_NOTICES.txt",
      "!node_modules/onnxruntime-node/bin/**/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/**/linux/**/*",
      "!node_modules/onnxruntime-node/bin/**/win32/arm64/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/ocr-notices",
        "to": "ocr-notices",
        "filter": [
          "*.txt"
        ]
      },
      {
        "from": "assets/tessdata",
        "to": "tessdata",
        "filter": [
          "*.traineddata.gz",
          "LICENSE.txt"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/**/*",
      "electron/ocr-worker.cjs",
      "electron/ocr-layout.cjs",
      "electron/pdf-worker.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Shaoye-Reimburse-Setup-${version}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "少爷今天报销了吗",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "electronDist": "node_modules/electron/dist"
  }
}
